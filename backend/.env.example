PORT=3000
NODE_ENV=development
# Allowed CORS Origins (comma-separated if multiple, defaults to http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
DB_CONNECT_STRING=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Leetcode
JWT_KEY=your_jwt_secret_key_here
# JWT expiration and auth cookie lifetime in seconds (default: 604800 = 7 days)
JWT_EXPIRES_IN_SECONDS=604800
# Cookie SameSite attribute: 'lax', 'strict', or 'none' (in production defaults to 'none', in development 'lax').
# NOTE: In production with cross-origin cookies, secure=true and sameSite=none are automatically enforced.
COOKIE_SAMESITE=lax
# Reverse proxy trust setting (e.g. 1 if behind Nginx/Cloudflare, or false)
TRUST_PROXY=1
# Global general rate limiter settings
# GENERAL_RATE_LIMIT_MAX: default 300 in production, 3000 when NODE_ENV !== 'production'
# GENERAL_RATE_LIMIT_WINDOW_MINUTES: window duration in minutes (default: 15)
GENERAL_RATE_LIMIT_MAX=3000
GENERAL_RATE_LIMIT_WINDOW_MINUTES=15
# Redis connection configuration (defaults to 127.0.0.1:6379 if omitted)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_PASS=your_redis_password_here
JUDGE0_KEY=your_judge0_api_key_here
# Judge0 polling configuration for batch submissions
JUDGE0_POLL_MAX_ATTEMPTS=30
JUDGE0_POLL_INTERVAL_MS=1000
GEMINI_KEY=your_gemini_api_key_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Show full input/expected/actual details for failed hidden test cases (default: true).
# When false, hidden failure returns { isHidden: true, input: null, expectedOutput: null, actualOutput: null }.
SHOW_FAILED_HIDDEN_TEST_DETAILS=true
