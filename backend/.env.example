# ==============================================================================
# DEPLOYMENT CHECKLIST:
# 1. Set NODE_ENV=production and generate a strong random JWT_KEY.
# 2. Configure DB_CONNECT_STRING and REDIS_HOST / REDIS_PASSWORD credentials.
# 3. Set CORS_ORIGIN and CLIENT_URL to your production frontend domain.
# 4. Uncomment TRUST_PROXY=1 only when deployed behind a reverse proxy/load balancer.
# 5. Provide valid JUDGE0_KEY and GEMINI_KEY credentials for execution and AI chat.
# ==============================================================================

PORT=3000
NODE_ENV=development
# Allowed CORS Origins (comma-separated if multiple, defaults to http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
DB_CONNECT_STRING=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Leetcode
# Isolated test database URI for automated tests (must be distinct from DB_CONNECT_STRING)
MONGO_TEST_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Leetcode_test
JWT_KEY=your_jwt_secret_key_here
# JWT expiration and auth cookie lifetime in seconds (default: 604800 = 7 days)
JWT_EXPIRES_IN_SECONDS=604800
# Cookie SameSite attribute: 'lax', 'strict', or 'none' (in production defaults to 'none', in development 'lax').
# NOTE: In production with cross-origin cookies, secure=true and sameSite=none are automatically enforced.
COOKIE_SAMESITE=lax
# Reverse proxy trust setting (enable only behind reverse proxy/load balancer like Render/Nginx)
# TRUST_PROXY=1 # Enable only behind reverse proxy/load balancer like Render/Nginx
# Global general rate limiter settings (default: 300 in production, 3000 in dev)
# GENERAL_RATE_LIMIT_MAX=3000 # Default is 300 in production, 3000 in development if unset
# GENERAL_RATE_LIMIT_WINDOW_MINUTES=15
# Redis connection configuration (defaults to 127.0.0.1:6379 if omitted)
# For free-tier deployment without an external Redis instance, set ALLOW_MEMORY_BLOCKLIST=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
# Set to 'true' to use an in-memory Map for JWT blacklisting when Redis is omitted or unavailable
ALLOW_MEMORY_BLOCKLIST=false

# ==============================================================================
# Judge0 Code Execution Configuration:
# Mode 1: RapidAPI Host (Requires RapidAPI account & key)
# JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_KEY=your_rapidapi_key_here
#
# Mode 2: Free Public / Self-Hosted Instance (No API key required)
# JUDGE0_BASE_URL=https://ce.judge0.com
# JUDGE0_KEY= # Leave empty for public instance without rapidapi headers
# ==============================================================================
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_KEY=your_judge0_api_key_here
# Judge0 polling configuration for batch submissions
JUDGE0_POLL_MAX_ATTEMPTS=30
JUDGE0_POLL_INTERVAL_MS=1000

# ==============================================================================
# Gemini AI Assistant Configuration:
# Primary and fallback model selection with resilient 429/404/503 handling
# ==============================================================================
GEMINI_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-pro

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Show full input/expected/actual details for failed hidden test cases (default: true).
# When false, hidden failure returns { isHidden: true, input: null, expectedOutput: null, actualOutput: null }.
SHOW_FAILED_HIDDEN_TEST_DETAILS=true
